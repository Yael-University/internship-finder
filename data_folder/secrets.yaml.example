# Copy this file to secrets.yaml and fill in your values.

# Groq API key for LLM job-fit scoring (free at https://console.groq.com — no credit card needed)
groq_api_key: 'gsk_...'

# LinkedIn login (optional — enables LinkedIn scraping)
# Uses undetected-chromedriver + a persistent Chrome profile so LinkedIn sees
# the same browser fingerprint every run.
linkedin_email: 'you@example.com'
linkedin_password: 'yourpassword'

# Handshake login (optional — works with any email, .edu or regular)
handshake_email: 'you@example.com'
handshake_password: 'yourpassword'

# Path to a PDF resume to reference in the report (optional, leave blank to skip)
resume_pdf_path: ''
